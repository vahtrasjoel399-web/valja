# --- Vercel Storage -> Neon/Postgres: connect to the Production environment ---
POSTGRES_URL=
# DATABASE_URL is also supported when added by the Neon integration.

# --- Cloudflare R2 (S3 API) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=valentina-photos

# --- Admin credentials ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Session signing secret: any long random string (openssl rand -hex 32) ---
SESSION_SECRET=
